{
  "policy_id": "app:securemcp-jira-reporter",
  "version": "0.2.0",
  "description": "Jira Reporter secured by SecureMCP",
  "resources": [
    "tool:generate_jira_report",
    "tool:find_delayed_issues"
  ],
  "constraints": {
    "parameters": {
      "tool:generate_jira_report": {
        "jql_query": {
          "type": "string",
          "max_length": 2000
        },
        "project_key": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,49}$"
        },
        "max_results": {
          "type": "integer",
          "min": 1,
          "max": 100
        }
      },
      "tool:find_delayed_issues": {
        "project_key": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,49}$"
        },
        "max_results": {
          "type": "integer",
          "min": 1,
          "max": 100
        }
      }
    }
  }
}
