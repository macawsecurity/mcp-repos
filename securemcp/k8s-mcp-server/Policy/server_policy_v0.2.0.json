{
  "policy_id": "app:securemcp-k8s-mcp-server",
  "version": "0.2.0",
  "description": "Kubernetes secured by SecureMCP",
  "resources": [
    "tool:describe_kubectl",
    "tool:describe_helm",
    "tool:describe_istioctl",
    "tool:describe_argocd"
  ],
  "denied_resources": [
    "tool:execute_kubectl",
    "tool:execute_helm",
    "tool:execute_istioctl",
    "tool:execute_argocd"
  ],
  "constraints": {
    "parameters": {
      "tool:describe_kubectl": {
        "command": {
          "type": "string",
          "max_length": 256
        }
      },
      "tool:describe_helm": {
        "command": {
          "type": "string",
          "max_length": 256
        }
      },
      "tool:describe_istioctl": {
        "command": {
          "type": "string",
          "max_length": 256
        }
      },
      "tool:describe_argocd": {
        "command": {
          "type": "string",
          "max_length": 256
        }
      }
    },
    "denied_parameters": {
      "tool:describe_kubectl": {
        "command": [
          "*|*",
          "*;*",
          "*&*",
          "*$(*",
          "*`*",
          "*>*",
          "*<*"
        ]
      },
      "tool:describe_helm": {
        "command": [
          "*|*",
          "*;*",
          "*&*",
          "*$(*",
          "*`*",
          "*>*",
          "*<*"
        ]
      },
      "tool:describe_istioctl": {
        "command": [
          "*|*",
          "*;*",
          "*&*",
          "*$(*",
          "*`*",
          "*>*",
          "*<*"
        ]
      },
      "tool:describe_argocd": {
        "command": [
          "*|*",
          "*;*",
          "*&*",
          "*$(*",
          "*`*",
          "*>*",
          "*<*"
        ]
      }
    }
  }
}
